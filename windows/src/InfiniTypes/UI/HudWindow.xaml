<Window x:Class="InfiniTypes.App.UI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfiniTypes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Panel" CornerRadius="14" Padding="16,10" Margin="12" MaxWidth="620"
            Background="#EE1F1F23" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Indicator" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="#FF4F8CFF" />
            <TextBlock x:Name="Message" Foreground="White" FontSize="14" FontFamily="Segoe UI Variable Text, Segoe UI"
                       TextWrapping="Wrap" MaxWidth="460" VerticalAlignment="Center" />
            <TextBlock x:Name="Countdown" Foreground="#B3FFFFFF" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                       FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular"
                       VerticalAlignment="Center" Visibility="Collapsed" />
            <Border x:Name="LevelTrack" Width="44" Height="6" CornerRadius="3" Margin="12,0,0,0" Background="#33FFFFFF"
                    VerticalAlignment="Center" Visibility="Collapsed">
                <Border x:Name="LevelBar" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="#FF4F8CFF" />
            </Border>
        </StackPanel>
    </Border>
</Window>
