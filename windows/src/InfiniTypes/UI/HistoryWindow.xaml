<Window x:Class="InfiniTypes.App.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico do InfiniTypes"
        Width="780" Height="720" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/InfiniTypes.ico">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Buscar" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="Search" Padding="6,4" TextChanged="SearchChanged" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Abrir a pasta" Padding="12,3" Margin="8,0,0,0" Click="OpenFolder" />
            <Button DockPanel.Dock="Right" x:Name="ExportButton" Content="Exportar avaliação" Padding="12,3" Click="Export" />
            <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.75" />
        </DockPanel>
        <ListBox x:Name="Records" HorizontalContentAlignment="Stretch" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="4,14,0,6" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="8" BorderThickness="1" BorderBrush="#22888888">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Copiar" Padding="10,2" Margin="4,0,0,0" Tag="{Binding}" Click="Copy" />
                                    <Button Content="{Binding Star}" Padding="8,2" Margin="4,0,0,0" Tag="{Binding}" Click="ToggleStar"
                                            ToolTip="Marcar para o conjunto de avaliação do refinador" />
                                    <Button Content="Excluir" Padding="10,2" Margin="4,0,0,0" Tag="{Binding}" Click="Delete" />
                                </StackPanel>
                                <TextBlock Text="{Binding Header}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="120"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                            <TextBlock Text="{Binding Status}" Foreground="#FFD08A2E" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding StatusVisibility}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
