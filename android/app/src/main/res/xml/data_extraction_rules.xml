<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para o backup na nuvem nem para outro aparelho: o histórico é privado e a chave da API
     só abre com a chave do Keystore deste aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
